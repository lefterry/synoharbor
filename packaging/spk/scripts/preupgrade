#!/bin/sh
set -eu
umask 077
# Consistent database snapshot + private ACME/key archive, outside the package.
# Browser CGI requests may still run after the worker stops; tarring a live var
# directory races SQLite WAL creation/removal and is not a recoverable backup.
VAR=/var/packages/synoharbor/var
BIN=/var/packages/synoharbor/target/bin/synoharbor
if [ -f "$VAR/synoharbor.sqlite" ]; then
 "$BIN" backup >/dev/null
fi
